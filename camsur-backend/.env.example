APP_NAME=Camsur AI Studio
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
API_PREFIX=/api/v1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-secret-or-service-role-key
SUPABASE_MEDIA_BUCKET=camsur-media
SUPABASE_ASSETS_BUCKET=camsur-backend-images
SIGNED_URL_EXPIRES_SEC=3600
SIGNED_URL_BFL_EXPIRES_SEC=7200
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host:6543/postgres

AI_PROVIDER=bfl
BFL_API_KEY=your_bfl_api_key
BFL_API_BASE=https://api.bfl.ai
BFL_MODEL=flux-2-pro
BFL_DUPLICATE_INPUT_IMAGE=true
BFL_OUTPUT_FIRST_MP_USD=0.03
BFL_OUTPUT_ADDITIONAL_MP_USD=0.015
BFL_INPUT_MP_USD=0.015
PRICING_VERSION=1

# Dev/test only — leave false (or unset) in production. Hard-disabled in code
# when ENVIRONMENT=production regardless of this value.
CREDITS_MANUAL_TOPUP_ENABLED=false
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_INTERVAL_SEC=21600
MARGIN_MONITOR_WINDOW_DAYS=7
MARGIN_MONITOR_MIN_SAMPLES=3

AI_GENERATION_ENABLED=true
GENERATION_MAINTENANCE_MODE=false
MAX_CONCURRENT_GENERATIONS_PER_USER=3
MAX_GLOBAL_ACTIVE_GENERATIONS=100
MAX_GENERATIONS_PER_USER_PER_HOUR=30
MAX_GENERATIONS_PER_USER_PER_DAY=100
MAX_CREDITS_SPENT_PER_USER_PER_HOUR=500
MAX_CREDITS_SPENT_PER_USER_PER_DAY=2000
MAX_GLOBAL_GENERATIONS_PER_HOUR=5000

MAX_UPLOAD_MB=10
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=25000000
UPLOAD_RETENTION_DAYS=30
OUTPUT_RETENTION_DAYS=90
SAVED_OUTPUT_RETENTION_DAYS=0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_GENERATE_PER_MINUTE=10
